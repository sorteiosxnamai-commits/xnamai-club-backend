PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Zero-config local database. The SQLite file is created automatically.
DB_TYPE=sqlite
DB_PATH=./data/xnamai.sqlite
TYPEORM_SYNCHRONIZE=true

# Optional PostgreSQL configuration. Create the database itself first; TypeORM creates the tables.
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=xnamai
# DB_PASSWORD=xnamai
# DB_NAME=xnamai_club
# TYPEORM_SYNCHRONIZE=true

# Demo admin seeded on first start
ADMIN_EMAIL=admin@xnamai.local
ADMIN_PASSWORD=Admin123!
