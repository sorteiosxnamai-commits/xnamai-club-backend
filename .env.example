PORT=4000
FRONTEND_URL=http://localhost:5173
# Production also allows www.clubxnamai.com.br and the Vercel URL.
# Extra origins, comma-separated (optional):
# CORS_ORIGINS=https://preview-host.vercel.app
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Zero-config local database. The SQLite file is created automatically.
DB_TYPE=sqlite
DB_PATH=./data/xnamai.sqlite
TYPEORM_SYNCHRONIZE=true

# Optional PostgreSQL configuration. Create the database itself first; TypeORM creates the tables.
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=xnamai
# DB_PASSWORD=xnamai
# DB_NAME=xnamai_club
# TYPEORM_SYNCHRONIZE=true

# Demo admin seeded on first start
ADMIN_EMAIL=admin@xnamai.local
ADMIN_PASSWORD=Admin123!

# Stripe — Dashboard → Developers → API keys (use sk_test_/pk_test_ until going live)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Restricted key with Webhook Endpoints write (rk_test_...). Used only to create the endpoint via API.
STRIPE_RESTRICTED_KEY=rk_test_replace_me

# Public HTTPS origin of this API (no trailing slash). Required to register the webhook.
# PUBLIC_API_URL=https://api.seudominio.com

# Filled automatically on first webhook create (secret is returned only then)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Vercel logs for the frontend admin page (/admin/logs)
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_FRONTEND_PROJECT_ID=
VERCEL_FRONTEND_PROJECT_NAME=xnamai-club-frontend
VERCEL_TEAM_ID=
